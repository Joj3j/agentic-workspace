# MDM Log Analyzer — copy to mdm-log-analyzer.env and set values.
# cp mdm-log-analyzer.env.example mdm-log-analyzer.env
#
# collect_logs.sh auto-loads mdm-log-analyzer.env next to this file, or the file
# pointed to by MDM_LOG_ANALYZER_ENV.

# =============================================================================
# Kubernetes cluster (use with: ./scripts/collect_logs.sh k8s)
# =============================================================================
# kubectl uses your default kubeconfig unless you override:
# MDM_KUBECONFIG=/path/to/kubeconfig
# MDM_K8S_CONTEXT=my-nsp-context          # passed as: kubectl --context <name>
#
# --- Canonical host for MDM-on-K8s (same value for SSH log pull) ---
# MDM runs as StatefulSet pods: mdm-server-0 .. mdm-server-(N-1). In HA clusters some replicas are
# active and others standby (e.g. 3 pods: 2 active + 1 standby; 5: 4+1 or 3+2; 7: 5+2).
# Set pod count for analysis/collection hints; pull logs from each pod separately (k8s mode per pod).
# MDM_CLUSTER_POD_COUNT=3
# MDM_HA_ACTIVE_STANDBY=2+1
#
# Node / jump host IP — SKILL.md "Mandatory execution order": SSH here first (keys pre-loaded), then kubectl/collect.
# MDM_K8S_NODE_IP=203.0.113.5

MDM_NAMESPACE=nsp-psa-privileged
MDM_MDM_SERVER_POD=mdm-server-0
MDM_LOG_ROOT=/opt/nsp/mediation/log

# Where kubectl cp writes by default (mdm-k8s-<timestamp> subdirectory)
# MDM_K8S_LOGS_DOWNLOAD_DIR=/var/tmp/mdm-k8s-logs

# =============================================================================
# Local MDM log server (SSH / scp; use with: ./scripts/collect_logs.sh ssh)
# Key auth preferred; else password prompt (interactive TTY). Host defaults to MDM_K8S_NODE_IP.
# =============================================================================
# MDM_LOCAL_SERVER_IP=          # optional SSH-only override; omit to use MDM_K8S_NODE_IP
# MDM_LOCAL_SSH_USER=root
# MDM_LOCAL_REMOTE_LOG_PATH=/opt/nsp/mediation/log
# MDM_LOCAL_SSH_PORT=22
# MDM_LOCAL_LOGS_DOWNLOAD_DIR=/var/tmp/mdm-local-server-logs

# =============================================================================
# MDM logs already on this machine (no kubectl, no scp)
# =============================================================================
# Set when you have copied / synced /mnt/mediation/log or a support bundle locally.
# Use as input to parse_mdm_logs.py, or run: ./scripts/collect_logs.sh local
# MDM_LOGS_LOCAL_DIR=/c/NSP/MDM/local-mdm-logs
#
# Hint for agents: when true, prefer MDM_LOGS_LOCAL_DIR for analysis paths.
# MDM_MDM_LOCAL=true

# =============================================================================
# Customer log server (SCP; use with: ./scripts/collect_logs.sh scp)
# =============================================================================
MDM_CUSTOMER_LOG_SERVER=192.0.2.10
MDM_SCP_USER=nspuser
# Optional non-default SSH port
# MDM_SCP_PORT=22

# Remote directory on the customer log server (often same as on-pod layout)
MDM_CUSTOMER_REMOTE_LOG_PATH=/opt/nsp/mediation/log

# Local directory where customer SCP downloads go (mdm-scp-<timestamp> subdirs)
# Windows (Git Bash): /c/NSP/MDM/customer-mdm-logs
MDM_CUSTOMER_LOGS_DOWNLOAD_DIR=/var/tmp/mdm-customer-logs

# =============================================================================
# Analysis outputs (parsed JSON, findings, HTML report)
# =============================================================================
# MDM_ANALYSIS_WORK_DIR=/var/tmp/mdm-analysis-work
