# mdm-patch-load configuration
# Copy this file to config.env and fill in values for your current patch run.
# config.env is gitignored — do not commit it.

# ---------- Build server ----------
MDM_BUILD_SERVER=jojijose@100.127.42.213
MDM_REMOTE_REPO_ROOT=/NSP/MED

# ---------- Cluster node (jump host / node1) ----------
# Update this each run with the target cluster's node1 IP.
MDM_CLUSTER_NODE=root@100.127.194.35
# Current active cluster: 100.127.194.35
MDM_CLUSTER_DIR=/opt/nsp/mdm

# ---------- Helm ----------
MDM_HELM_NAMESPACE=nsp-psa-privileged
MDM_HELM_RELEASE=mdm-server
MDM_HELM_VALUES=/opt/nsp/config/helm/values/mdm/mdm-server/values.yaml

# ---------- Image / chart version ----------
# Set to the exact tag produced by buildDockerImage (confirm from build output).
MDM_SERVER_VERSION=26.0.0-rel.105-SNAPSHOT

# ---------- Docker registry ----------
MDM_REGISTRY=orbw-artifactory.ca.alcatel-lucent.com:8081/nokia-nsp-docker-virtual

# ---------- SNAPSHOT versions for shared libs ----------
# Bump these to match the version being published for this patch.
MDM_SNAPSHOT_VERSION=1.5.0-rel.13-SNAPSHOT

# ---------- Git ----------
MDM_BRANCH_PREFIX=jojijose
# Set to a short, descriptive name for the patch (e.g. fix-ssh-timeout)
MDM_BRANCH_NAME=
